#region VEXcode Generated Robot Configuration
from vex import *
import urandom
import math

# Brain should be defined by default
brain = Brain()

# Robot configuration code
brain_inertial = Inertial()
optical_2 = Optical(Ports.PORT2)
optical_5 = Optical(Ports.PORT5)


# Wait for sensor(s) to fully initialize
wait(100, MSEC)

# generating and setting random seed
def initializeRandomSeed():
    wait(100, MSEC)
    xaxis = brain_inertial.acceleration(XAXIS) * 1000
    yaxis = brain_inertial.acceleration(YAXIS) * 1000
    zaxis = brain_inertial.acceleration(ZAXIS) * 1000
    systemTime = brain.timer.system() * 100
    urandom.seed(int(xaxis + yaxis + zaxis + systemTime)) 

# Initialize random seed 
initializeRandomSeed()


# Color to String Helper
def convert_color_to_string(col):
    if col == Color.RED:
        return "red"
    if col == Color.GREEN:
        return "green"
    if col == Color.BLUE:
        return "blue"
    if col == Color.WHITE:
        return "white"
    if col == Color.YELLOW:
        return "yellow"
    if col == Color.ORANGE:
        return "orange"
    if col == Color.PURPLE:
        return "purple"
    if col == Color.CYAN:
        return "cyan"
    if col == Color.BLACK:
        return "black"
    if col == Color.TRANSPARENT:
        return "transparent"
    return ""

#endregion VEXcode Generated Robot Configuration
myVariable = 0

def when_started1():
    global myVariable, vexcode_brain_precision, vexcode_console_precision
    optical_2.set_light_power(100, PERCENT)
    optical_5.set_light_power(100, PERCENT)
    while not (((optical_2.hue() + optical_5.hue())/2)>=350 or  ((optical_2.hue() + optical_5.hue())/2)<=15):
    ## (((optical_2.hue() + optical_5.hue())/2)>=80 and  ((optical_2.hue() + optical_5.hue())/2)<=150)
    ##((optical_2.color == Color.GREEN) and (optical_5.color==Color.GREEN))
        brain.screen.print("Not BLUE") 
        brain.screen.next_row()
        wait (5, MSEC)
    brain.screen.clear_screen()
    brain.screen.set_cursor(1, 1)
    brain.screen.print("BlUE")
    wait (1000, MSEC)
    brain.screen.next_row()
    brain.screen.print("optical_2: ") 
    brain.screen.print(optical_2.brightness()) 
    brain.screen.next_row()
    brain.screen.print("optical_5: ")
    brain.screen.print(optical_5.brightness())
    brain.screen.next_row()


when_started1()
